{
    "manifest_version": 3,
    "name": "Speech to FSL Translator",
    "version": "1.0.0",
    "description": "A browser extension for translating speech into Filipino Sign Language.",

    "action": {
        "default_title": "Speech to FSL Translator",
        "default_popup": "popup.html"
    },

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "dictionary.json",
                "assets/gifs/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}